# Database Configuration (Neon Serverless Postgres)
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Firecrawl (used to read JS-rendered pages). Without it, AgentTag fetches the URL directly.
FIRECRAWL_API_KEY="fc-your-api-key-here"

# Model / Synthesizer Configuration (Optional)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Cloud Relay & Public URLs (Default for local development)
PORT=10000
NEXT_PUBLIC_RELAY_URL="http://localhost:10000"
NEXT_PUBLIC_CDN_URL="http://localhost:3000"
